# Stewarrd - configuration
# Copy to .env (local) or to your Unraid env file, then fill in the values.
# Keep this file private (chmod 600): it holds API keys.

# ---------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------
# Seerr, as reachable FROM THE CONTAINER. On Unraid's default bridge network use the server IP.
SEERR_URL=http://192.168.1.10:5055
# Seerr > Settings > General > API Key
SEERR_API_KEY=
# Your Seerr user id (Seerr > Users > your profile; the number in /users/<id>).
# This user is the admin: unlimited credits, owns direct additions, can purge.
ADMIN_USER_ID=1
# Shared secret for the Seerr webhook. Generate with: openssl rand -hex 32
# Put the same value in Seerr's webhook Authorization Header as: Bearer <secret>
WEBHOOK_SECRET=

# ---------------------------------------------------------------
# CREDIT ECONOMY
# ---------------------------------------------------------------
# Every non-admin user's allowance. The weekly integrity check corrects balances against this.
DEFAULT_CREDITS=3
CREDIT_COST_MOVIE=1
# Charged per requested season
CREDIT_COST_TV_SEASON=2
# Minimum days an owner must hold an item (requested or claimed) before releasing it. A rate limit on requests.
# 0 = no minimum. This is only the default: an admin can change it in the dashboard. The admin is exempt.
MIN_STEWARDSHIP_DAYS=30

# ---------------------------------------------------------------
# OPTIONAL SERVICES
# ---------------------------------------------------------------
# Radarr / Sonarr: used for the admin's purge buttons and for finding direct additions.
# Nothing is ever deleted automatically; only an admin clicking Purge calls these.
RADARR_URL=http://192.168.1.10:7878
RADARR_API_KEY=
SONARR_URL=http://192.168.1.10:8989
SONARR_API_KEY=

# ---------------------------------------------------------------
# SEERR REQUEST SYNC (optional)
# ---------------------------------------------------------------
# WARNING: with 1, Stewarrd DELETES and CREATES requests in Seerr. Deleted requests can't be restored. Back up Seerr's database first.
# 1 = claiming creates a Seerr request for the new owner, an admin purge removes the Seerr requests of the deleted item,
#     and every integrity check (weekly and manual) deletes completed/filled Seerr requests. Releasing never touches Seerr.
# Off by default in normal mode. Regardless of this setting, the webhook always approves/declines pending requests.
# Tip: try it on one test user first with SEERR_SYNC_USER_IDS.
SEERR_SYNC=0
# Only touch Seerr requests of these user ids (comma separated). Empty = everyone.
SEERR_SYNC_USER_IDS=

# ---------------------------------------------------------------
# LOGIN / SERVER
# ---------------------------------------------------------------
# Users sign in with Plex. No app registration is needed.
# Signs the session cookie. If empty, a random one is generated and kept in /app/data.
SESSION_SECRET=
# Days a login lasts
SESSION_DAYS=14
# Set to 1 only when running behind an HTTPS reverse proxy, so session cookies are marked Secure.
TRUST_PROXY=0
PORT=3000
HOST=0.0.0.0
# State directory (database, snapshots, reports). Inside the container this is /app/data.
DATA_DIR=data

# ---------------------------------------------------------------
# TESTING MODES - leave these OUT of a normal deployment
# ---------------------------------------------------------------
# DEV_MODE=1       Fake users and simulation endpoints; external services disabled.
# ADMIN_RUN=1      Fake-login user picker with REAL Seerr; Radarr/Sonarr disabled.
#                  Refuses to start when NODE_ENV=production.
# ADMIN_RUN_ALLOW_REMOTE=1   Lets admin run listen on a non-loopback address.
#                  Anyone who can reach the port can act as any user, so keep it LAN-only.
