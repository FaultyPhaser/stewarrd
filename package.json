  "description": "Storage stewardship and credit system sidecar for Seerr (Overseerr/Jellyseerr)",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FaultyPhaser/stewarrd.git"
  },
  "homepage": "https://github.com/FaultyPhaser/stewarrd#readme",
